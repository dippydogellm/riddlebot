# --- Required ---------------------------------------------------------
BOT_TOKEN=123456:ABC-your-token-from-@BotFather

# 32-byte hex. Generate with: npm run keygen
# Encrypts every stored seed. Back it up — losing it loses every wallet.
MASTER_KEY=

# --- XRPL -------------------------------------------------------------
# Mainnet:  wss://xrplcluster.com   or  wss://s1.ripple.com
# Testnet:  wss://s.altnet.rippletest.net:51233
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
XRPL_NETWORK=testnet

# --- Market data ------------------------------------------------------
XRPLTO_API_BASE=https://api.xrpl.to/v1
XRPLTO_API_KEY=

# --- Trading defaults -------------------------------------------------
DEFAULT_SLIPPAGE_BPS=300
QUICK_BUY_XRP=5,10,25,100
RESERVE_BUFFER_XRP=2

# --- Revenue ----------------------------------------------------------
# 100 bps = 1% of trade volume, paid to FEE_WALLET after each fill.
FEE_BPS=100
FEE_WALLET=

# --- Branding ---------------------------------------------------------
BRAND_SITE=https://riddlelabs.io
BRAND_SUPPORT=@riddlelabs

# --- Ops --------------------------------------------------------------
# On Railway this must point at the mounted volume, e.g. /data/bot.db,
# or every redeploy wipes the wallets.
DB_PATH=./data/bot.db
ADMIN_IDS=

# --- Admin panel (Vercel /api/admin) ----------------------------------
# Sets the sellable ad-footer link shown at the bottom of bot messages.
ADMIN_USER=
ADMIN_PASS=
# Signs the admin session cookie. Generate with: npm run keygen
ADMIN_SESSION_SECRET=

# Shared settings store. Serverless functions don't share local disk, so the
# ad slot lives in Vercel Edge Config where both the panel and the bot see it.
EDGE_CONFIG_ID=
EDGE_CONFIG_READ_TOKEN=
# Vercel API token — only the admin panel needs it, to write Edge Config.
VERCEL_API_TOKEN=

# --- Webhook mode (Vercel only) ---------------------------------------
# The long-running polling deployment is authoritative. Telegram delivers each
# update once, so never run polling and a webhook against the same token.
# Leave ENABLE_WEBHOOK unset/0 unless this is the ONLY deployment.
ENABLE_WEBHOOK=0
WEBHOOK_SECRET=
